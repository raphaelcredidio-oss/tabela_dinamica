from dash import Dash, html, dcc
import plotly.express as px
import pandas as pd

# 1. Leia o arquivo ‘ecommerce_estatistica (1).csv’ dentro de um dataframe
df = pd.read_csv('ecommerce_estatistica (1).csv')

# Inicializa a aplicação Dash
app = Dash(__name__)
app.title = 'Dashboard de E-commerce'

# 2. Crie gráficos interativos usando Plotly baseados nas colunas do dataset
# Gráfico 1: Histograma de Preços
fig_preco = px.histogram(df, x='Preço', nbins=30, title='Distribuição de Preços dos Produtos',
                         labels={'Preço': 'Preço (R$)', 'count': 'Quantidade'})

# Gráfico 2: Dispersão entre Preço e Nota, colorido por Gênero
fig_scatter = px.scatter(df, x='Preço', y='Nota', color='Gênero',
                           title='Relação entre Preço e Nota dos Produtos',
                           labels={'Preço': 'Preço (R$)', 'Nota': 'Nota do Produto'})

# Gráfico 3: Top Marcas por Quantidade de Produtos
top_marcas = df['Marca'].value_counts().reset_index().head(10)
top_marcas.columns = ['Marca', 'Contagem']
fig_marcas = px.bar(top_marcas, x='Marca', y='Contagem', title='Top 10 Marcas com Mais Produtos',
                    labels={'Marca': 'Marca', 'Contagem': 'Número de Produtos'})

# 3. Layout da Aplicação Dash
app.layout = html.Div(children=[
    html.H1(children='Dashboard de Análise de E-commerce', style={'textAlign': 'center', 'color': '#333'})
    
    html.Div(children='Aplicação interativa desenvolvida com Dash e Plotly para visualização de dados.', 
             style={'textAlign': 'center', 'marginBottom': '30px', 'color': '#666'}),

    # Bloco com o primeiro gráfico
    html.Div([
        dcc.Graph(
            id='grafico-preco',
            figure=fig_preco
        )
    ], style={'width': '80%', 'margin': 'auto'}),

    # Bloco com os gráficos lado a lado ou empilhados
    html.Div([
        html.Div([
            dcc.Graph(
                id='grafico-scatter',
                figure=fig_scatter
            )
        ], style={'width': '48%', 'display': 'inline-block'}),

        html.Div([
            dcc.Graph(
                id='grafico-marcas',
                figure=fig_marcas
            )
        ], style={'width': '48%', 'display': 'inline-block', 'float': 'right'})
    ], style={'width': '80%', 'margin': 'auto', 'marginTop': '20px'})
])

# Como acessar a aplicação: Após rodar o script no seu terminal ou IDE, o Dash vai gerar um link local no terminal (geralmente [http://127.0.0.1:8050/](http://127.0.0.1:8050/)). Basta clicar ou copiar esse link no seu navegador para interagir com o seu dashboard em tempo real!

# Executa o servidor local
if __name__ == '__main__':
    app.run_server(debug=True)